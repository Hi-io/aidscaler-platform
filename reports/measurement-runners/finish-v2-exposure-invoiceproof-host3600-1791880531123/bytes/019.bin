            "authorId": "adbb7b14e8b9132359446070",
            "authorName": "Lena M.",
            "text": "b51 | 23 people will sleep here tonight. We have twelve blankets, one per person. The remaining people have nothing to cover them. Please help with the shortfall; the old video about an empty shelter is from a different incident.",
            "format": "video",
            "publishedAt": 55000,
            "claimedAt": null,
            "location": null,
            "language": "en",
            "references": [],
            "likes": 26,
            "version": 1,
            "attachments": [
              {
                "id": "81a7baab5321f6dc33f8ff1a",
