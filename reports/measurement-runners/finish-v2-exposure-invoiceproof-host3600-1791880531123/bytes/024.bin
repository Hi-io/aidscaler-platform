/** Offline metadata accounting. Does not change any child's admitted budget. */
import {validateStudyClosure as historicalClosure} from './finish-local-study-guards.mjs';
export const ADMISSION_CAPS=Object.freeze({versioned_controls:.45,additional:.45,read_relay:.15,K11_K13:.12,
  K07:.50,K14:.70,coupled100:.30,physical_chain:0,S19:.75,K15:.40,K22:.45,K18:.40,federation12:0,local_latency:0});
export const SELECTED_NOMINAL_CAPS=Object.freeze({...ADMISSION_CAPS,additional:.30,K07:.40,K14:.60,S19:.60,K15:.30,K22:.35,K18:.30});
const nonnegative=x=>typeof x==='number'&&Number.isFinite(x)&&x>=0;
const max=values=>values.filter(nonnegative).length?Math.max(...values.filter(nonnegative)):null;
function charges(value={}){return [value.chargedBudgetUsd,value.chargedExposureUsd,value.cost?.chargedBudgetUsd,
  value.budget?.chargedBudgetUsd,value.costSummary?.chargedBudgetUsd,value.conservativeCommittedUsd];}
function inflight(value={}){
  const active=value.activeEpisode??value.active;
  return [value.unsettledReservedUsd,value.activeUnknownReserveUsd,value.pendingReservedUsd,
    active?.maxReserveUsd,active?.reservedCapUsd,active?.reservedUsd,active?.cap,active?.episodeCapUsd];
}
function feeCollections(summary={}){
  return [summary.worlds,summary.cases,summary.allOutcomes].filter(Array.isArray).filter(rows=>rows.length);
}
function rowFee(row={}){return row.fee??row.cost??row.readout?.costs??row;}
function trustedFee(value={}){
  const amount=value.totalProviderCostUsd;
  return nonnegative(amount)&&(value.totalCostKnown===true||value.allAttemptCostsKnown===true||
    Number.isSafeInteger(value.paidCalls)&&value.paidCalls>=0&&value.unknownCostCalls===0&&value.unknownReserveCalls===0);
}
function invoiceEvidence(artifacts,knownSubtotal){
  const s=artifacts.summary??{},i=artifacts.index??{},p=artifacts.progress??{},
    collections=[...feeCollections(s),...feeCollections(i)],nodes=[s,s.cost,s.costSummary,s.budget,i,i.cost,i.costSummary,i.budget,p,p.cost].filter(Boolean),
    nested=collections.flatMap(rows=>rows.map(rowFee)),allNodes=[...nodes,...nested],
    explicitTerminalUnknown=[s,s.cost,s.costSummary,s.budget].filter(Boolean).some(n=>
      Object.hasOwn(n,'totalProviderCostUsd')&&n.totalProviderCostUsd===null||n.totalCostKnown===false||n.allAttemptCostsKnown===false),
    unknownNested=nested.some(n=>n.totalCostKnown===false||n.usageMissing===true||
      ['unknownCostRows','unknownCostCalls','unknownBudgetRows'].some(k=>Object.hasOwn(n,k)&&(n[k]===null||n[k]>0))),
    candidates=nodes.filter(trustedFee).map(n=>n.totalProviderCostUsd);
  for(const rows of collections){const fees=rows.map(rowFee);
    if(fees.every(trustedFee))candidates.push(fees.reduce((sum,n)=>sum+n.totalProviderCostUsd,0));}
  const certified=max(candidates),belowKnownSubtotal=nonnegative(certified)&&nonnegative(knownSubtotal)&&certified+1e-12<knownSubtotal,
    blocked=explicitTerminalUnknown||unknownNested||belowKnownSubtotal;
  return {totalProviderCostUsd:blocked?null:certified,certifiedCandidateCount:candidates.length,
    explicitTerminalUnknown,unknownNested,belowKnownSubtotal,
    knownSubtotalCandidates:allNodes.map(n=>n.knownCostSubtotalUsd??n.knownSubtotalUsd??n.knownCostUsd)};
}
export function conservativeStudyAccounting(artifacts={},study,closure={}){
  const admission=ADMISSION_CAPS[study?.id];
  if(!nonnegative(admission)||study.maxReserveUsd!==admission)throw Error('Exact existing child admission ceiling required');
  const s=artifacts.summary??{},i=artifacts.index??{},p=artifacts.progress??{},observedCharge=max([...charges(s),...charges(i),...charges(p)]),
    attempts=(artifacts.attempts??[]).filter(a=>['started','running','inflight_not_an_outcome'].includes(a.state)),
    reserve=max([...inflight(s),...inflight(i),...inflight(p),...attempts.flatMap(a=>[a.reservedUsd,a.capUsd,a.episodeCapUsd,a.reservedCapUsd])]),settledCharge=max([s.chargedBudgetUsd,i.chargedBudgetUsd,p.chargedBudgetUsd,
      s.cost?.chargedBudgetUsd,i.cost?.chargedBudgetUsd,s.budget?.chargedBudgetUsd,i.budget?.chargedBudgetUsd]),
    settledPlusInflight=nonnegative(settledCharge)&&nonnegative(reserve)?settledCharge+reserve:null,
    unknownRows=max([s.unknownBudgetRows,s.unknownCostRows,s.unknownCostCalls,s.cost?.unknownBudgetRows,i.unknownCostRows]),
    complete=closure.permitsNext===true&&!(reserve>0)&&attempts.length===0&&s.usageMissing!==true&&i.usageMissing!==true,
    knownBase=max([s.knownCostUsd,s.totalKnownCostUsd,s.knownCostSubtotalUsd,s.cost?.knownCostUsd,
      s.cost?.knownSubtotalUsd,s.costSummary?.knownSubtotalUsd,s.budget?.knownCostUsd,
      i.knownCostUsd,i.knownCostSubtotalUsd,i.cost?.knownCostUsd,i.budget?.knownCostUsd]),
    collectionSubtotals=[...feeCollections(s),...feeCollections(i)].map(rows=>{
      const fees=rows.map(rowFee),values=fees.map(n=>n.knownCostSubtotalUsd??n.knownSubtotalUsd??n.knownCostUsd);
      return values.every(nonnegative)?values.reduce((sum,n)=>sum+n,0):null;}),
    knownSubtotal=max([knownBase,...collectionSubtotals]),feeProof=invoiceEvidence(artifacts,knownSubtotal),invoice=feeProof.totalProviderCostUsd;
  // Neither a stale summary nor a later index can hide the other's reserve.
  // An incomplete/no-fee checkpoint preserves the entire admitted ceiling.
  const fallbackRequired=!complete||observedCharge===null||invoice===null||unknownRows>0,
    charge=Math.max(observedCharge??0,settledPlusInflight??0,knownSubtotal??0,invoice??0,fallbackRequired?admission:0);
  return {chargedBudgetUsd:charge,maximumDeclaredExposureUsd:admission,declaredStudyAdmissionBudgetUsd:admission,
    selectedNominalPaidCapsUsd:SELECTED_NOMINAL_CAPS[study.id],knownCostSubtotalUsd:knownSubtotal,
    totalProviderCostUsd:complete&&!(unknownRows>0)?invoice:null,
    observedCheckpointChargeUsd:observedCharge,observedInflightReserveUsd:reserve,
    settledPlusInflightUsd:settledPlusInflight,closureComplete:complete,
    invoiceEvidence:{certifiedCandidateCount:feeProof.certifiedCandidateCount,explicitTerminalUnknown:feeProof.explicitTerminalUnknown,
      unknownNested:feeProof.unknownNested,belowKnownSubtotal:feeProof.belowKnownSubtotal},
    unknownUsageOrIncomplete:!complete||invoice===null||unknownRows>0,
    budgetFallbackToDeclaredCeiling:fallbackRequired,
    note:'Budget exposure is not a bill. Native child budgets/calls/physics remain unchanged. A bill requires explicit complete fee/ledger evidence; legacy costUsd or an old index cannot fill an explicitly unknown terminal total. Nested fee uncertainty and totals below known subtotals remain unknown. Incomplete/missing evidence retains the full admission ceiling. Real reported spending is never capped downward.'};
}
export function validateExposureClosure(id,artifacts,process={exitCode:0,signal:null}){
  if(id!=='K18')return historicalClosure(id,artifacts,process);
  const s=artifacts.summary??{},final=s.finalBuilds??{},reasons=[],closed=s.plannedEpisodes===6&&s.closedEpisodes===6&&
    Array.isArray(s.cases)&&s.cases.length===6&&s.cases.every(c=>c.status==='completed'&&Array.isArray(c.invariants)&&!c.invariants.length&&c.geometryProfileAudit?.matches===true)&&
    Array.isArray(s.missingOutcomes)&&!s.missingOutcomes.length&&Array.isArray(s.notAttempted)&&!s.notAttempted.length&&!s.stoppedReason&&
    final.candidateChanged===false&&final.evaluatorChanged===false&&final.simulatorChanged===false&&
    s.humanEvaluatorChanged===false&&s.humanEvaluatorFinalFingerprint==='75c635a59eda752820aabef317a42799915a46a5fc7fba82ad9d0382d69ea29e'&&
    s.comparisonRejected!==true&&s.comparisons?.length===2&&s.comparisons.every(c=>['B5','B8'].includes(c.baseline)&&c.independentWorlds===2);
  if(!closed)reasons.push('incomplete_or_invalid_K18_native_closure');
  if(process.exitCode!==0)reasons.push('child_nonzero_exit');if(process.signal!=null)reasons.push('process_signal');
  if(process.loggingErrors?.length)reasons.push('logging_failure');
  return {closed,permitsNext:!reasons.length,reasons,
    note:'Internal two-map geometry transfer only; all six native profiles, baseline losses, recovered errors and censored demand retained. No external independence or cross-version pooling.'};
}
