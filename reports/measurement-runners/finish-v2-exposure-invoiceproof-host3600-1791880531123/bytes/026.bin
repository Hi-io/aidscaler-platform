/** New expectation-only amendment; the active bridge's files remain immutable. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {PILOT_CONFIG} from '../evaluation/harness.mjs';
import {NEW_SOURCE,currentSource,validateNewSource} from './version-bridge-v2.mjs';
const originalPath='.local/version-bridge-v2-prepared-1791876267417/additional-plan.json';
const originalSha='e98cb36ba4e9ab54025791b06b770010cae0fc278a45da2be976c5c274fd63f4';
const sha=b=>createHash('sha256').update(b).digest('hex');
export async function originalAdditionalPlan(){const bytes=await readFile(originalPath);
  if(sha(bytes)!==originalSha)throw Error('Source-bound old expectation plan changed');return JSON.parse(bytes.toString('utf8'));}
export function amendNativeExpectation(old,{declaredAt}={}){
  if(PILOT_CONFIG.packetLoss!==0)throw Error('The actual frozen harness default changed');
  const plan=structuredClone(old);plan.declaredAt=declaredAt;
  for(const g of plan.groups.filter(g=>['formal_immediate','burst'].includes(g.id))){
    if(g.desiredNativeScenario.packetLoss!==.02)throw Error('Exact historical mistaken expectation required');
    g.desiredNativeScenario.packetLoss=0;
  }
  plan.nativeObservationAmendment={schema:'additional-v4-actual-native-packet0-before-own-outcomes',
    original:{path:resolve(originalPath),sha256:originalSha},authorization:'ROOT_EXPECTATION_PACKET0_PREPARATION',
    previousExpectedPacketLoss:.02,actualFrozenHarnessPacketLoss:0,
    scope:'Expectation only for selected formal_immediate/burst; no API kwargs/configuration/physics/seed/rates/caps changed',
    unchangedApiInputs:true,silentLossRemainsBlocked:true,declaredBeforeOwnOutcomes:true};
  return plan;
}
export async function validateAdditionalNative0File(plan,{sha256,expectedSha,current}={}){
  validateNewSource(current);
  if(typeof expectedSha!=='string'||!/^[a-f0-9]{64}$/.test(expectedSha)||sha256!==expectedSha)throw Error('Exact archived native0 plan SHA required');
  const old=await originalAdditionalPlan(),expected=amendNativeExpectation(old,{declaredAt:plan.declaredAt});
  if(JSON.stringify(plan)!==JSON.stringify(expected)||JSON.stringify(plan.sourceAtDeclaration)!==JSON.stringify(NEW_SOURCE))
    throw Error('Only the authorized native packet expectation amendment is allowed');
  return true;
}
export async function prepareAdditionalNative0(options={}){
  const source=await currentSource();validateNewSource(source);const old=await originalAdditionalPlan(),
    plan=amendNativeExpectation(old,{declaredAt:new Date().toISOString()}),bytes=JSON.stringify(plan,null,2)+'\n',
    directory=resolve(options.folder??'.local/additional-native0-v2-prepared-'+Date.now());
  await mkdir(directory,{recursive:true});await writeFile(resolve(directory,'plan.json'),bytes,{flag:'wx'});
  await writeFile(resolve(directory,'original-plan.json'),await readFile(originalPath),{flag:'wx'});
  return {directory,path:resolve(directory,'plan.json'),sha256:sha(bytes),worldsStarted:0,modelCalls:0};
}
