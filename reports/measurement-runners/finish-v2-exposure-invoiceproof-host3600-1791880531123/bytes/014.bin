import test from 'node:test';
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {campaignPlan} from '../scripts/human-capacity-campaign.mjs';
import {bridgeGroups as oldGroups,NEW_SOURCE,readJson} from './version-bridge-v2.mjs';
import {bridgeGroups,amendHostGroups,readStoppedBridgeAntecedent,HOST_LIMIT_MS,verifyCurrentHumanRaws,
  validateHostBridgePlan,ORIGINAL_BRIDGE_PLAN} from './version-bridge-host3600-v2.mjs';
import {coordinateBridgeControls} from './compact-human-controls-bridge-host3600-v2.mjs';
test('actual frozen CLI uses wall-ms milliseconds; wall-limit would be ignored',()=>{
  assert.equal(campaignPlan({'wall-ms':3600000}).config.wallLimitMs,3600000);
  assert.equal(campaignPlan({'wall-limit':3600}).config.wallLimitMs,900000);
});
test('common host cap changes no world/native human/physics/LLM input in any of the nine worlds',async()=>{
  const old=await oldGroups(),groups=await bridgeGroups();assert.equal(groups.length,3);
  assert.equal(groups.flatMap(g=>g.plan.worlds).length,9);
  for(let i=0;i<groups.length;i++){
    const a=groups[i],b=old[i],ao={...a.options},ac={...a.plan.config},bc={...b.plan.config};
    assert.equal(ao['wall-ms'],'3600000');delete ao['wall-ms'];assert.deepEqual(ao,b.options);
    assert.equal(ac.wallLimitMs,HOST_LIMIT_MS);delete ac.wallLimitMs;delete bc.wallLimitMs;assert.deepEqual(ac,bc);
    assert.deepEqual(a.plan.worlds,b.plan.worlds);assert.equal(a.plan.episodeBudgetUsd,.15);
    assert.equal(a.plan.totalBudgetUsd,b.plan.totalBudgetUsd);assert.equal(a.plan.config.horizonMs,10800000);
  }
});
test('only the original900s cap can be amended, no hidden alternate cap',async()=>{
  const groups=await oldGroups();groups[0].plan.config.wallLimitMs=60;
  assert.throws(()=>amendHostGroups(groups),/original900000/);
});
test('settled stopped attempt retains all9/3/6, wall-limit failure and exact fee once',async()=>{
  const prior=await readStoppedBridgeAntecedent();assert.equal(prior.declaredRuns,9);assert.equal(prior.observedRuns,3);
  assert.equal(prior.missingRuns,6);assert.equal(prior.raw.length,3);assert.equal(prior.closedComparableGroupRuns,0);
  assert.equal(prior.raw.find(r=>r.arm==='C_decentralized').status,'wall_limit');assert.equal(prior.accounting.costUsd,.00622966);
  assert.equal(prior.accounting.modelCalls,6);assert.equal(prior.accounting.usageUnknown,false);
  assert.equal(prior.oldCutoffCannotSupportNumericalAdvantage,true);
});
test('old failed bridge cannot satisfy the new complete closure; no grandfathering successes',async()=>{
  const old=await readJson(ORIGINAL_BRIDGE_PLAN);await assert.rejects(()=>validateHostBridgePlan(old.data));
  const prior=await readStoppedBridgeAntecedent(),row=await readJson(prior.raw.find(r=>r.arm==='C_manual').path);
  assert.throws(()=>verifyCurrentHumanRaws([row],NEW_SOURCE),/common3600000/);
});
test('new host runner default launches no child and has new root GO and stop namespace',async()=>{
  const result=await coordinateBridgeControls();assert.equal(result.worldsStarted,0);assert.equal(result.modelCalls,0);
  const source=await readFile('.local/compact-human-controls-bridge-host3600-v2.mjs','utf8');
  assert.match(source,/ROOT_GO_COMPACT_BRIDGE_HOST3600_V2/);assert.match(source,/STOP_COMPACT_BRIDGE_HOST3600_V2/);
});
