/** Ignored orchestration-only host amendment; no core, physics or model change. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {resolve} from 'node:path';
import {campaignPlan} from '../scripts/human-capacity-campaign.mjs';
import {readJson,sha,currentSource,sameSource,validateNewSource,validateV4Gate,gateCounts,
  readHistoricalPrimary,readHistoricalControls,bridgeGroups as originalGroups,
  verifyCurrentHumanRaws as originalVerify,readClosedBridge as originalReadClosed} from './version-bridge-v2.mjs';
export * from './version-bridge-v2.mjs';
export const HOST_LIMIT_MS=3600000;
export const ORIGINAL_BRIDGE_PLAN='.local/version-bridge-v2-prepared-1791876267417/plan.json';
export const ORIGINAL_BRIDGE_SHA='5d7cfd40cd31335733b92d2834a24e058750dee9a84e95e0c1bc6637774b8a53';
export const STOPPED_BRIDGE='reports/human-capacity-controls-bridge/native-bridge-v2-20261013';
const key=w=>[w.condition??w.profile,w.seed,w.arm].join(':');
const nonnegative=x=>typeof x==='number'&&Number.isFinite(x)&&x>=0;

export function amendHostGroups(groups){
  return groups.map(original=>{
    if(original.plan.config.wallLimitMs!==900000)throw Error('Exact original900000ms host cap required');
    const options={...original.options,'wall-ms':String(HOST_LIMIT_MS)},plan=campaignPlan(options),
      oldConfig={...original.plan.config},newConfig={...plan.config};
    delete oldConfig.wallLimitMs;delete newConfig.wallLimitMs;
    if(JSON.stringify(oldConfig)!==JSON.stringify(newConfig)||JSON.stringify(plan.worlds)!==JSON.stringify(original.plan.worlds)||
      plan.episodeBudgetUsd!==original.plan.episodeBudgetUsd||plan.totalBudgetUsd!==original.plan.totalBudgetUsd||
      plan.config.wallLimitMs!==HOST_LIMIT_MS)throw Error('Host amendment changed physics/cohort/provider limits');
    return {...original,options,plan,hostAmendment:{previousHostWallLimitMs:900000,hostWallLimitMs:HOST_LIMIT_MS,
      appliesToAllPlannedArms:true,physicalHorizonUnchanged:true,providerCapsUnchanged:true},
      reason:'Repeat every decentralized arm and retain pending stress worlds after shared host limit amendment; no outcome selection'};
  });
}
export async function bridgeGroups(){return amendHostGroups(await originalGroups());}

/** Preserve a stopped attempt without interpreting its cutoff as physical failure or advantage. */
export async function readStoppedBridgeAntecedent(){
  const old=await readJson(ORIGINAL_BRIDGE_PLAN);
  if(old.sha256!==ORIGINAL_BRIDGE_SHA)throw Error('Original bridge preregistration bytes changed');
  const index=await readJson(resolve(STOPPED_BRIDGE,'index.json')),protocol=await readJson(resolve(STOPPED_BRIDGE,'protocol.json'));
  if(protocol.data.plan?.sha256!==old.sha256||!sameSource(index.data.source,old.data.source)||
    index.data.declaredRuns!==9||index.data.observedRuns!==3||index.data.unsettledReservedUsd!==0||
    index.data.records?.length!==1||index.data.records[0].id!=='decentralized'||
    index.data.records[0].closure?.permitsNext!==false||index.data.stoppedReason!=='failed_or_incomplete_group'||
    index.data.missingGroups?.join(',')!=='stress48,stress96')throw Error('Exact settled9/3/6 antecedent required');
  const record=index.data.records[0],expected=new Map(old.data.groups[0].plan.worlds.map(w=>[key(w),w])),raw=[];
  for(const row of record.worlds??[]){const r=await readJson(row.path),w=r.data;
    if(r.sha256!==row.sha256||!expected.delete(key(w))||w.protocol?.wallLimitMs!==900000||
      w.candidateFingerprint!==old.data.source.candidate||w.baseEvaluatorFingerprint!==old.data.source.baseEvaluator||
      w.evaluatorFingerprint!==old.data.source.humanEvaluator||w.manifest?.engineBuild!==old.data.source.simulator||
      w.candidateChanged!==false||w.evaluatorChanged!==false||w.simulatorChanged!==false||w.invariants?.length!==0||
      (w.arm==='C_decentralized'?w.status!=='wall_limit'||!w.errors?.some(e=>e.code==='WALL_LIMIT'):w.status!=='completed'))
      throw Error('Stopped raw bytes, status or source integrity changed');
    raw.push({path:r.path,sha256:r.sha256,status:w.status,arm:w.arm,wallMs:w.wallMs,
      costUsd:nonnegative(w.costUsd)?w.costUsd:null,modelCalls:Number.isSafeInteger(w.modelCalls)?w.modelCalls:null});
  }
  if(expected.size||raw.length!==3)throw Error('All three stopped-group raws required');
  const summary=await readJson(record.summary.path);
  if(summary.sha256!==record.summary.sha256)throw Error('Stopped summary bytes changed');
  return {schema:'retained-stopped-host900-attempt',folder:resolve(STOPPED_BRIDGE),source:old.data.source,
    declaredRuns:9,observedRuns:3,missingRuns:6,closedComparableGroupRuns:0,
    reason:'C_decentralized exceeded shared900s host allowance; no source change or broken physical invariant',
    priorPlan:{path:old.path,sha256:old.sha256},index:{path:index.path,sha256:index.sha256},
    protocol:{path:protocol.path,sha256:protocol.sha256},summary:{path:summary.path,sha256:summary.sha256},raw,
    accounting:record.budget,feesCountedOnce:true,cutoffIsPhysicalFailure:false,
    oldCutoffCannotSupportNumericalAdvantage:true,statisticalPoolingAllowed:false};
}

export function verifyCurrentHumanRaws(rows,source){
  originalVerify(rows,source);
  if(rows.some(r=>(r.data??r).protocol?.wallLimitMs!==HOST_LIMIT_MS))throw Error('Every arm must use declared common3600000ms host limit');
  return true;
}
export async function readClosedBridge(folder,source,prepared){
  await validateHostBridgePlan(prepared.data);
  const closed=await originalReadClosed(folder,source,prepared);
  const rows=await Promise.all(closed.raw.map(r=>readJson(r.path)));verifyCurrentHumanRaws(rows,source);
  return {...closed,hostAmendment:prepared.data.hostAmendment,retainedStoppedHost900:prepared.data.stoppedAntecedent,
    poolingAcrossHostAmendmentAllowed:false};
}
export async function validateHostBridgePlan(plan){
  const original=await readJson(ORIGINAL_BRIDGE_PLAN),antecedent=await readStoppedBridgeAntecedent();
  if(plan.schema!=='native-human-compact-control-bridge-host3600-before-new-outcomes'||
    original.sha256!==ORIGINAL_BRIDGE_SHA||!sameSource(plan.source,original.data.source)||
    JSON.stringify(plan.groups)!==JSON.stringify(await bridgeGroups())||
    JSON.stringify(plan.amended)!==JSON.stringify(original.data.amended)||
    JSON.stringify(plan.stoppedAntecedent)!==JSON.stringify(antecedent)||
    plan.declaredRuns!==9||plan.maximumReservedUsd!==.45||plan.maximumModelCalls!==72||
    plan.hostAmendment?.hostWallLimitMs!==HOST_LIMIT_MS||plan.hostAmendment?.previousHostWallLimitMs!==900000||
    plan.hostAmendment?.physicalHorizonUnchanged!==true||plan.hostAmendment?.appliesToAllPlannedArms!==true)
    throw Error('Exact immutable host-only amendment required');
  return true;
}
export async function prepareBridge(options={}){
  const old=await readJson(ORIGINAL_BRIDGE_PLAN),source=await currentSource();validateNewSource(source);
  if(old.sha256!==ORIGINAL_BRIDGE_SHA||!sameSource(source,old.data.source))throw Error('Exact frozen v4 source required');
  const freeze=await readJson(old.data.freeze.path),t27=await readJson(old.data.t27.path);
  validateV4Gate(freeze.data,source);
  if(freeze.sha256!==old.data.freeze.sha256||t27.sha256!==old.data.t27.sha256||
    t27.data.valid!==true||t27.data.passed!==true||t27.data.sourceUnchanged!==true)throw Error('Frozen full/UI/T27 proof bytes changed');
  const primary=await readHistoricalPrimary(),historicalControls=await readHistoricalControls(),
    stoppedAntecedent=await readStoppedBridgeAntecedent(),groups=await bridgeGroups(),
    directory=resolve(options.folder??'.local/version-bridge-host3600-v2-prepared-'+Date.now()),files=[];
  const paths=[...old.data.files.map(f=>f.path),ORIGINAL_BRIDGE_PLAN,
    '.local/version-bridge-host3600-v2.mjs','.local/compact-human-controls-bridge-host3600-v2.mjs','.local/bridge-host3600-v2.test.mjs',
    stoppedAntecedent.index.path,stoppedAntecedent.protocol.path,stoppedAntecedent.summary.path,...stoppedAntecedent.raw.map(r=>r.path)];
  await mkdir(resolve(directory,'bytes'),{recursive:true});
  for(const path of [...new Set(paths.map(path=>resolve(path)))]){const bytes=await readFile(path);
    files.push({path,sha256:sha(bytes)});await writeFile(resolve(directory,'bytes',String(files.length-1).padStart(2,'0')+'.bin'),bytes,{flag:'wx'});}
  const plan={...old.data,schema:'native-human-compact-control-bridge-host3600-before-new-outcomes',
    declaredAt:new Date().toISOString(),groups,primary,historicalControls,stoppedAntecedent,files,
    stopFile:resolve('.local/STOP_COMPACT_BRIDGE_HOST3600_V2'),worldsStarted:0,modelCalls:0,
    freeze:{path:freeze.path,sha256:freeze.sha256,counts:gateCounts(freeze.data)},
    hostAmendment:{authorization:'ROOT_PREP_HOST3600_BRIDGE',previousHostWallLimitMs:900000,hostWallLimitMs:HOST_LIMIT_MS,
      appliesToAllPlannedArms:true,physicalHorizonUnchanged:true,providerCapsUnchanged:true,
      reason:'Observed host SQL/polling wall limits and predeclared48/96 scalability; same physical source clock and horizon',
      newRunRequiredForAllNine:true,statisticalPoolingAllowed:false,previousAttemptRetained:true},
    prerequisite:'Fresh hashes/full486/sim247/UI113/T27 unchanged; explicit new root GO; all nine raws must close'};
  await validateHostBridgePlan(plan);const bytes=JSON.stringify(plan,null,2)+'\n';
  await writeFile(resolve(directory,'plan.json'),bytes,{flag:'wx'});
  await writeFile(resolve(directory,'freeze.json'),freeze.bytes,{flag:'wx'});
  await writeFile(resolve(directory,'t27.json'),t27.bytes,{flag:'wx'});
  return {folder:directory,planPath:resolve(directory,'plan.json'),planSha256:sha(bytes),source,
    hostWallLimitMs:HOST_LIMIT_MS,declaredRuns:9,maximumReservedUsd:.45,maximumModelCalls:72,worldsStarted:0,modelCalls:0};
}
