/** Final sequential orchestration. No world/provider without named root GO. */
import {readFile,writeFile,mkdir,readdir,access} from 'node:fs/promises';
import {createWriteStream} from 'node:fs';
import {createHash} from 'node:crypto';
import {resolve,sep} from 'node:path';
import {fileURLToPath} from 'node:url';
import {spawn} from 'node:child_process';
import {buildFingerprint,evaluatorFingerprint} from '../evaluation/harness.mjs';
import {humanCapacityEvaluatorFingerprint} from '../evaluation/human-capacity-benchmark.mjs';
import {requireLoadedSimulatorBuild} from '../evaluation/simulator-build.mjs';
import {validateHumanCampaignGate} from '../scripts/human-capacity-campaign.mjs';
import {classifyClosedGroup} from './compact-human-controls-coordinator.mjs';
import {validateV4Gate,gateCounts,readHistoricalPrimary,readClosedBridge,readHistoricalControls,validateNewSource,validateHostBridgePlan} from './version-bridge-host3600-v2.mjs';
import {validateGate as validateFederationGate} from './federation-structural-control.mjs';
import {plannedStage,mechanismReview} from './finish-local-study-guards.mjs';
import {conservativeStudyAccounting,validateExposureClosure as validateStudyClosure,ADMISSION_CAPS,SELECTED_NOMINAL_CAPS} from './finish-local-exposure-v2-guards.mjs';
import {validateAdditionalNative0File} from './additional-native0-v2-guards.mjs';

const sha=b=>createHash('sha256').update(b).digest('hex');
const json=async path=>{const bytes=await readFile(resolve(path));return {path:resolve(path),bytes,
  sha256:sha(bytes),data:JSON.parse(bytes.toString('utf8'))};};
const root=resolve('.'),lock=resolve('.local/PAID_RESEARCH_STUDY.lock'),globalStop=resolve('.local/STOP_FINISH_LOCAL_STUDIES_V2');
const same=(a,b)=>['candidate','baseEvaluator','humanEvaluator','simulator'].every(k=>a?.[k]===b?.[k]);
async function current(){return {candidate:await buildFingerprint(),baseEvaluator:await evaluatorFingerprint(),
  humanEvaluator:await humanCapacityEvaluatorFingerprint(),simulator:await requireLoadedSimulatorBuild()};}
const exists=async path=>{try{await access(path);return true;}catch(e){if(e.code!=='ENOENT')throw e;return false;}};
const names=async directory=>(await readdir(resolve(directory),{withFileTypes:true}).catch(e=>e.code==='ENOENT'?[]:Promise.reject(e)))
  .filter(e=>e.isDirectory()).map(e=>e.name);
const inWorkspace=path=>resolve(path).toLowerCase().startsWith((root+sep).toLowerCase());

function baseDefinitions(amended){return [
  {id:'versioned_controls',stage:'human',externalPrelude:true,entry:'.local/compact-human-controls-bridge-host3600-v2.mjs',maxReserveUsd:.45,
    fixed:['--run=ROOT_GO_COMPACT_BRIDGE_HOST3600_V2']},
  {id:'additional',stage:'human',entry:'.local/run-additional-human-controls-v2-native0.mjs',maxReserveUsd:.30,folder:true,
    fixed:['--plan='+(amended?.additional.path??'PENDING_V2_ADDITIONAL_PLAN'),'--plan-sha='+(amended?.additional.sha256??'PENDING_SHA'),'--groups=formal_immediate,burst','--run=ROOT_GO_ADDITIONAL_HUMAN_CONTROLS_V2_NATIVE0'],
    stopFile:'.local/STOP_ADDITIONAL_HUMAN_CONTROLS_V2_NATIVE0'},
  {id:'read_relay',stage:'human',entry:'.local/run-read-relay-error-amendment-v2.mjs',maxReserveUsd:.15,folder:true,
    fixed:['--plan='+(amended?.readRelay.path??'PENDING_V2_READ_RELAY_PLAN'),'--plan-sha='+(amended?.readRelay.sha256??'PENDING_SHA'),'--run=ROOT_GO_READ_RELAY_ERROR_V2'],stopFile:'.local/STOP_READ_RELAY_ERROR_AMENDMENT_V2'},
  {id:'K11_K13',stage:'evidence',entry:'.local/minimal-semantic-studies.mjs',maxReserveUsd:.12,folder:true,
    fixed:['--kind=K11_K13','--run=ROOT_GO_SEMANTIC_PILOT'],stopFile:'.local/STOP_MINIMAL_SEMANTIC_STUDIES'},
  {id:'K07',stage:'evidence',entry:'.local/research-studies-controlled.mjs',maxReserveUsd:.40,
    fixed:['--study=K07','--run=ROOT_GO_K07'],discovery:{root:'reports/ablations',prefix:'repair-gated-'},stopFile:'.local/STOP_RESEARCH_K07_CANDIDATE'},
  {id:'K14',stage:'evidence',entry:'.local/research-studies-controlled.mjs',maxReserveUsd:.60,
    fixed:['--study=K14','--run=ROOT_GO_K14'],discovery:{root:'reports/ablations',prefix:'inquiry-gated-'},stopFile:'.local/STOP_RESEARCH_K14_CANDIDATE'},
  {id:'coupled100',stage:'evidence',entry:'.local/combined-100-controlled.mjs',maxReserveUsd:.30,
    fixed:['--run=ROOT_GO_100'],discovery:{root:'reports/combined',prefix:'coupled-100-current-'},stopFile:'.local/STOP_COUPLED_100_CURRENT'},
  {id:'physical_chain',stage:'evidence',entry:'.local/physical-scenario-evidence.mjs',maxReserveUsd:0,
    fixed:['--run=ROOT_GO_PHYSICAL_CHAIN'],discovery:{root:'reports/physical-chain',prefix:'native-current-'},stopFile:'.local/STOP_PHYSICAL_CHAIN_CURRENT'},
  {id:'S19',stage:'evidence',entry:'.local/current-service-recovery.mjs',maxReserveUsd:.60,folder:true,
    fixed:['--study=S19','--run=ROOT_GO_S19_CURRENT'],stopFile:'.local/STOP_CURRENT_SERVICE_RECOVERY'},
  {id:'K15',stage:'evidence',entry:'.local/minimal-semantic-studies.mjs',maxReserveUsd:.30,folder:true,
    fixed:['--kind=K15','--run=ROOT_GO_K15_CURRENT'],stopFile:'.local/STOP_MINIMAL_SEMANTIC_STUDIES'},
  {id:'K22',stage:'evidence',entry:'.local/current-service-recovery.mjs',maxReserveUsd:.35,folder:true,
    fixed:['--study=K22','--run=ROOT_GO_K22_CURRENT'],stopFile:'.local/STOP_CURRENT_SERVICE_RECOVERY'},
  {id:'federation12',stage:'evidence',entry:'.local/federation-structural-control.mjs',maxReserveUsd:0,thinLock:true,
    fixed:['--execute','--authorization=ROOT_GO_FEDERATION'],discovery:{root:'reports/federation-structural',prefix:''},
    noStopHook:true,sealInsteadOfFreeze:true},
  {id:'local_latency',stage:'evidence',entry:'.local/local-latency-evidence.mjs',maxReserveUsd:0,
    fixed:['--run=ROOT_GO_LOCAL_LATENCY'],discovery:{root:'reports/local-latency',prefix:'current-'},stopFile:'.local/STOP_LOCAL_LATENCY_CURRENT'}
];}
export function definitions(amended,evidence){
  const base=baseDefinitions(amended).map(s=>({...s,maxReserveUsd:ADMISSION_CAPS[s.id],
    declaredStudyAdmissionBudgetUsd:ADMISSION_CAPS[s.id],selectedNominalPaidCapsUsd:SELECTED_NOMINAL_CAPS[s.id]}));
  base.splice(base.findIndex(s=>s.id==='federation12'),0,{id:'K18',stage:'evidence',entry:'.local/geometry-transfer-controlled.mjs',
    maxReserveUsd:.40,declaredStudyAdmissionBudgetUsd:.40,selectedNominalPaidCapsUsd:.30,
    fixed:['--run=ROOT_GO_K18'],discovery:{root:'reports/discovery',prefix:'geometry-gated-'},stopFile:'.local/STOP_GEOMETRY_TRANSFER_CANDIDATE'});
  if(!evidence)return base;
  validateNewSource(evidence.source);
  const allowed=['K11_K13','K07','K14','coupled100','physical_chain','S19','K15','K22','K18'],
    entries=Array.isArray(evidence.entries)?Object.fromEntries(evidence.entries.map(e=>[e.id,e])):evidence.entries;
  if(!entries||Object.keys(entries).length!==allowed.length||allowed.some(id=>!entries[id]))throw Error('Exact nine evidence runner entries required');
  const normalizedArgs=args=>args.map(a=>a.startsWith('--run=')?a.replace(/_V2$/,''):a);
  return base.map(study=>{
    if(!allowed.includes(study.id))return study;const e=entries[study.id],fixed=e.fixedArgs??study.fixed;
    if(!inWorkspace(e.entry)||resolve(e.entry)!==resolve(study.entry.replace(/\.mjs$/,'-v2.mjs'))||
      !/^[a-f0-9]{64}$/.test(e.entrySha256??'')||JSON.stringify(normalizedArgs(fixed))!==JSON.stringify(normalizedArgs(study.fixed))||
      e.maxReserveUsd!=null&&e.maxReserveUsd!==study.maxReserveUsd||
      e.folder!=null&&e.folder!==Boolean(study.folder)||e.discovery!=null&&JSON.stringify(e.discovery)!==JSON.stringify(study.discovery)||
      e.stopFile!=null&&e.stopFile!==study.stopFile&&e.stopFile!==study.stopFile+'_V2')
      throw Error('Evidence runner changed undeclared scheduling/arguments/scope for '+study.id);
    return {...study,entry:e.entry,fixed,...(e.stopFile?{stopFile:e.stopFile}:{}),entrySha256:e.entrySha256};
  });
}

export function validateFinishGate(freeze,t27,source,counts){
  validateV4Gate(freeze,source);
  const actual=gateCounts(freeze);
  if(!counts||actual.platform!==486||actual.simulator!==247||actual.ui!==113||JSON.stringify(actual)!==JSON.stringify(counts))
    throw Error('Exact archived fresh full/UI counts required');
  if(t27?.valid!==true||t27?.passed!==true||t27.sourceUnchanged!==true||
    [t27.initialFingerprints,t27.finalFingerprints].some(f=>f?.candidate!==source.candidate||f?.evaluator!==source.baseEvaluator||f?.simulator!==source.simulator))
    throw Error('Fresh current-base T27 receipt required');
  return true;
}

const helperPaths=[
  '.local/finish-local-studies-v2-exposure.mjs','.local/finish-local-study-guards.mjs','.local/finish-local-lock-child-v2.mjs',
  '.local/version-bridge-v2.test.mjs','.local/finish-local-exposure-v2-guards.mjs','.local/finish-local-exposure-v2.test.mjs',
  '.local/additional-native0-v2-guards.mjs',
  '.local/run-read-relay-error-amendment-v2.mjs','.local/evidence-probe-guards.mjs','.local/evidence-probe-guards-v2.mjs','.local/read-human-capacity-evidence.mjs',
  '.local/version-bridge-v2.mjs','.local/compact-human-controls-bridge-v2.mjs',
  '.local/version-bridge-host3600-v2.mjs','.local/compact-human-controls-bridge-host3600-v2.mjs','.local/bridge-host3600-v2.test.mjs',
  '.local/additional-human-controls-prepared-1791868369772/plan.json',
  '.local/read-relay-error-amendment-1791867513712/plan.json',
  'scripts/human-capacity-campaign.mjs','evaluation/human-capacity-benchmark.mjs','scripts/semantic-load.mjs'];
export async function prepareFinishPlan(options={}){
  for(const p of ['bridge-plan','seal','evidence-manifest','native-additional-plan','native-additional-plan-sha'])if(!options[p])throw Error('Explicit --'+p+' required');
  const bridge=await json(options['bridge-plan']),source=await current(),freeze=await json(bridge.data.freeze.path),
    t27=await json(bridge.data.t27.path),federationSeal=await json(options.seal),evidence=await json(options['evidence-manifest']),
    nativeAdditional=await json(options['native-additional-plan']);
  if(!same(bridge.data.source,source))throw Error('Current v4 bridge plan required');
  await validateHostBridgePlan(bridge.data);
  validateFinishGate(freeze.data,t27.data,source,bridge.data.freeze.counts);
  const federationProofs=await Promise.all([federationSeal.data.verification,federationSeal.data.ui.path,federationSeal.data.engineBenchmark].map(json));
  validateFederationGate(federationSeal.data,...federationProofs.map(p=>p.data),
    {candidate:source.candidate,evaluator:source.baseEvaluator,simulator:source.simulator},'ROOT_GO_FEDERATION');
  const primary=await readHistoricalPrimary(),oldControls=await readHistoricalControls();
  if(JSON.stringify(primary)!==JSON.stringify(bridge.data.primary)||JSON.stringify(oldControls)!==JSON.stringify(bridge.data.historicalControls))
    throw Error('Historical predecessor bytes changed');
  await validateAdditionalNative0File(nativeAdditional.data,{sha256:nativeAdditional.sha256,expectedSha:options['native-additional-plan-sha'],current:source});
  const amended={...bridge.data.amended,additional:{path:nativeAdditional.path,sha256:nativeAdditional.sha256,
    originalSourceBoundPlan:bridge.data.amended.additional}},studies=definitions(amended,evidence.data),files=[];
  for(const s of studies)if(s.entrySha256&&sha(await readFile(s.entry))!==s.entrySha256)throw Error('Evidence runner bytes changed');
  for(const path of [...new Set([...helperPaths,...studies.map(s=>s.entry),...Object.values(amended).map(p=>p.path),bridge.path,evidence.path])]){
    const bytes=await readFile(resolve(path));files.push({path:resolve(path),sha256:sha(bytes),bytes:bytes.length});
  }
  const plan={schema:'finish-local-studies-sequential-versioned-exposure-before-v2-outcomes',declaredAt:new Date().toISOString(),source,
    state:'PREPARED_NOT_LAUNCHED',worldsStarted:0,modelCalls:0,studies,files,versionBridge:{path:bridge.path,sha256:bridge.sha256,amended},
    evidenceRunners:{path:evidence.path,sha256:evidence.sha256,entries:evidence.data},
    historicalPrimary:primary,historicalControls:oldControls,t27:{path:t27.path,sha256:t27.sha256},gateCounts:bridge.data.freeze.counts,
    coverageType:'EXPLICIT_VERSIONED_COVERAGE',statisticalPoolingAllowed:false,all17SingleVersionClosed:false,
    freeze:{path:freeze.path,sha256:freeze.sha256},federationSeal:{path:federationSeal.path,sha256:federationSeal.sha256,
      proofs:federationProofs.map(p=>({path:p.path,sha256:p.sha256}))},
    universalLock:lock,parentAcquiresResearchLock:false,worldConcurrency:1,paidConcurrency:1,
    compactPrelude:'Versioned requirement coverage only: v1 primary12 and partial controls17/11/8/failure retained; host900 v4 bridge9/3/6 retained; shared host3600 nine paired worlds must all close. Never relabel or statistically pool versions or host allowances.',
    hostAmendment:bridge.data.hostAmendment,retainedStoppedHost900:bridge.data.stoppedAntecedent,
    feePartitions:{v1ControlFees:oldControls.accounting,stoppedHost900Fees:bridge.data.stoppedAntecedent.accounting,
      newHost3600Fees:'Read only from its eventual closed nine-world receipt; none presumed',
      notes:'Each attempt is retained and charged once separately; no prior fee is charged again to a new child admission cap.'},
    prerequisites:['Historical v1 primary12 retained','Fresh current-base T27 receipt','EXPLICIT_VERSIONED_COVERAGE v1 plus closed v2 nine raw worlds',
      'Explicit ROOT_GO_FINISH_LOCAL_STUDIES_V2','Universal lock empty before each child','Exact archived runner bytes/current source/new full count/247sim/UI113'],
    signalPolicy:'Write global and active runner-specific stop markers and wait for its settled boundary. Never kill/forward Windows signals to a child/provider. Runners without a hook finish their active child; PID and cap exposure remain recorded. No later launch.',
    selectionPolicy:'Only stage all|human|evidence changes scheduling; all14rows stay declared. No metric, improvement or favorable-case selector. Every recovered error/loss/censor and explicit3silent-loss missing worlds stays retained.',
    limits:['K11 legacy child has its own predeclared300s wall policy; this parent adds no kill timer.',
      'Federation requires its separate seal and a thin lock child because its legacy runner has no universal lock.',
      'An exit0 alone is insufficient: exact native/source/closed artifact checks apply. A nonzero exit stops except the declared additional missing3 case.',
      'Every child cap and physical parameter comes from its existing prepared runner; no new scenario/model/resource/prompt parameters.']};
  const folder=resolve(options.folder??'.local/finish-local-studies-v2-exposure-prepared-'+Date.now());await mkdir(resolve(folder,'bytes'),{recursive:true});
  for(const [at,file]of files.entries())await writeFile(resolve(folder,'bytes',String(at).padStart(2,'0')+'.bin'),await readFile(file.path),{flag:'wx'});
  for(const [name,bytes]of[['plan.json',JSON.stringify(plan,null,2)+'\n'],['freeze.json',freeze.bytes],['federation-seal.json',federationSeal.bytes]])
    await writeFile(resolve(folder,name),bytes,{flag:'wx'});
  return {folder,planPath:resolve(folder,'plan.json'),planSha256:sha(JSON.stringify(plan,null,2)+'\n'),
    coordinatorSha256:files.find(f=>f.path===resolve('.local/finish-local-studies-v2-exposure.mjs')).sha256,worldsStarted:0,modelCalls:0};
}

async function artifactRows(directory){
  const files=[];async function walk(path){for(const e of await readdir(path,{withFileTypes:true})){const p=resolve(path,e.name);
    if(e.isDirectory())await walk(p);else if(e.name.endsWith('.json'))files.push(p);}}
  await walk(resolve(directory));const rows=[];for(const file of files)rows.push(await json(file));return rows;
}

async function loadStudyArtifacts(study,folder){
  const rows=await artifactRows(folder),named=name=>rows.find(r=>r.path===resolve(folder,name))?.data,
    summary=named('summary.json'),index=named('index.json');
  let raw=[];if(study.id==='physical_chain')for(const c of index?.cases??[])raw.push((await json(c.file)).data);
  if(study.id==='local_latency')raw=[named('raw.json')].filter(Boolean);
  return {summary,index,raw,progress:named('progress.json'),attempts:rows.filter(r=>/attempt-\d+\.json$/i.test(r.path)).map(r=>r.data),
    readout:named('readout.json'),files:rows.map(r=>({path:r.path,sha256:r.sha256,bytes:r.bytes.length}))};
}

async function launch(args,stdoutPath,stderrPath,onPid,onProgress){
  const out=createWriteStream(stdoutPath,{flags:'wx'}),err=createWriteStream(stderrPath,{flags:'wx'}),loggingErrors=[];
  const finish=s=>new Promise(done=>{let ended=false;const end=()=>{if(!ended){ended=true;done();}};
    s.once('finish',end);s.once('close',end);s.once('error',e=>{loggingErrors.push({code:e.code??e.name});end();});});
  const logsDone=Promise.all([finish(out),finish(err)]);
  const child=spawn(process.execPath,['--env-file-if-exists=../../nexo-platform/.env.local',...args],
    {cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe']});
  let buffer='';
  child.stdout.on('data',bytes=>{buffer+=bytes.toString('utf8');if(buffer.length>262144)buffer=buffer.slice(-262144);
    for(let i;(i=buffer.indexOf('\n'))>=0;){const line=buffer.slice(0,i);buffer=buffer.slice(i+1);
      try{const value=JSON.parse(line);if(typeof value.phase==='string')onProgress(value.phase);}catch{}}});
  child.stdout.pipe(out);child.stderr.pipe(err);
  const settled=new Promise(done=>{child.once('error',e=>done({exitCode:null,signal:null,error:{code:e.code??e.name}}));
    child.once('close',(exitCode,signal)=>done({exitCode,signal}));});
  console.log(JSON.stringify({phase:'child_pid_issued',pid:child.pid}));
  try{await onPid(child.pid);}catch(e){loggingErrors.push({phase:'pid_checkpoint_failed',code:e.code??e.name});}
  const result=await settled;await logsDone;return {...result,loggingErrors};
}

export async function runFinishStudies(options={}){
  if(options.prepare)return prepareFinishPlan(options);
  if(options.run!=='ROOT_GO_FINISH_LOCAL_STUDIES_V2')return {state:'PREPARED_NOT_LAUNCHED',worldsStarted:0,modelCalls:0,
    studies:definitions().map(s=>s.id),compactNeverRelaunched:true};
  for(const name of ['plan','plan-sha','completed-bridge'])if(!options[name])throw Error('Explicit --'+name+' required');
  const prepared=await json(options.plan),plan=prepared.data,source=await current(),freeze=await json(plan.freeze.path),
    t27=await json(plan.t27.path),seal=await json(plan.federationSeal.path),bridge=await json(plan.versionBridge.path);
  if(prepared.sha256!==options['plan-sha']||JSON.stringify(plan.studies)!==JSON.stringify(definitions(plan.versionBridge.amended,plan.evidenceRunners.entries))||
    plan.schema!=='finish-local-studies-sequential-versioned-exposure-before-v2-outcomes'||!same(plan.source,source)||
    freeze.sha256!==plan.freeze.sha256||seal.sha256!==plan.federationSeal.sha256||bridge.sha256!==plan.versionBridge.sha256||t27.sha256!==plan.t27.sha256)throw Error('Exact plan/source/seal changed');
  validateFinishGate(freeze.data,t27.data,source,plan.gateCounts);
  for(const p of plan.federationSeal.proofs)if(sha(await readFile(p.path))!==p.sha256)throw Error('Federation proof bytes changed');
  for(const f of plan.files)if(sha(await readFile(f.path))!==f.sha256)throw Error('Prepared runner bytes changed:'+f.path);
  if(await exists(lock))throw Error('Universal NEWlock active; no launch/no automatic waiting');
  if(await exists(globalStop))throw Error('Preserve existing global stop marker');
  const primary=await readHistoricalPrimary(),compact=await readClosedBridge(options['completed-bridge'],source,bridge),
    stage=options.stage??'all',selected=plannedStage(plan,stage).filter(s=>!s.externalPrelude);
  let humanPrelude=null;
  if(stage==='evidence'){
    if(!options['completed-human'])throw Error('Evidence stage requires its closed prior human-stage receipt');
    humanPrelude=await json(resolve(options['completed-human'],'index.json'));
    if(humanPrelude.data.stage!=='human'||humanPrelude.data.stoppedReason||!same(humanPrelude.data.source,source)||
      !['additional','read_relay'].every(id=>humanPrelude.data.records.some(r=>r.id===id&&r.state==='closed_valid'&&r.closure?.permitsNext===true)))
      throw Error('Human stage incomplete/invalid; evidence must not bypass it');
    for(const record of humanPrelude.data.records.filter(r=>['additional','read_relay'].includes(r.id)))for(const file of record.artifacts??[])
      if(!inWorkspace(file.path)||sha(await readFile(file.path))!==file.sha256)throw Error('Closed human-stage artifacts changed');
  }
  const
    folder=resolve(options.folder??'reports/finish-local-studies-v2-exposure/'+Date.now());await mkdir(resolve(folder,'logs'),{recursive:true});
  await writeFile(resolve(folder,'protocol.json'),JSON.stringify({plan,planSha256:prepared.sha256,source,stage,
    authorization:'ROOT_GO_FINISH_LOCAL_STUDIES_V2',primary,t27:{path:t27.path,sha256:t27.sha256},compactPrelude:compact,
    humanPrelude:humanPrelude?{path:humanPrelude.path,sha256:humanPrelude.sha256}:null,
    declaredAllFourteen:plan.studies.map(s=>s.id),stageSelection:selected.map(s=>s.id),parentResearchLock:false},null,2)+'\n',{flag:'wx'});
  await writeFile(resolve(folder,'prepared-plan.json'),prepared.bytes,{flag:'wx'});
  for(const [at,f]of plan.files.entries())await writeFile(resolve(folder,'runner-'+String(at).padStart(2,'0')+'.bin'),await readFile(f.path),{flag:'wx'});
  const records=[{id:'versioned_controls',state:'closed_external_versioned_coverage',...compact},
    ...(humanPrelude?humanPrelude.data.records.filter(r=>['additional','read_relay'].includes(r.id))
      .map(r=>({...r,state:'closed_external_human_prelude',previousIndex:humanPrelude.path,executedInEarlierStage:true})):[])];
  let stoppedReason=null,interrupted=false,active=null;
  const index=async()=>writeFile(resolve(folder,'index.json'),JSON.stringify({recordedAt:new Date().toISOString(),source,stage,records,
    declared:plan.studies.map(s=>s.id),notLaunched:plan.studies.filter(s=>!records.some(r=>r.id===s.id)).map(s=>({id:s.id,stage:s.stage,state:'not_launched'})),
    stoppedReason,active,activeUnknownReserveUsd:active?.maxReserveUsd??0,
    versionedControlFeesCountedOnce:true,statisticalPoolingAllowed:false,all17SingleVersionClosed:false,parentResearchLock:false},null,2)+'\n');await index();
  const signal=()=>{interrupted=true;const info=JSON.stringify({at:new Date().toISOString(),scope:'finish-local-studies',active:active?.id??null});
    const paths=[globalStop,...(active?.stopFile?[resolve(active.stopFile)]:[])];
    for(const path of paths)writeFile(path,info+'\n',{flag:'a'}).catch(e=>console.error(JSON.stringify({phase:'stop_marker_write_failed',code:e.code??e.name})));
    console.log(JSON.stringify({phase:'stop_requested_waiting_settled_child',id:active?.id??null,pid:active?.pid??null}));};
  process.on('SIGINT',signal);process.on('SIGTERM',signal);
  try{for(const study of selected){
    if(interrupted||await exists(globalStop)){stoppedReason='operator_stop';break;}
    if(await exists(lock)){stoppedReason='NEWlock_not_empty';break;}
    if(!same(await current(),source)){stoppedReason='source_changed';break;}
    for(const f of plan.files)if(sha(await readFile(f.path))!==f.sha256){stoppedReason='runner_bytes_changed';break;}
    if(stoppedReason)break;
    if(study.stopFile&&await exists(resolve(study.stopFile))){stoppedReason='existing_study_stop_marker';break;}
    const destination=resolve(folder,study.id),before=study.discovery?new Set(await names(study.discovery.root)):null;
    const args=[study.entry,...study.fixed,study.sealInsteadOfFreeze?'--seal='+seal.path:'--freeze='+freeze.path];
    if(study.folder)args.push('--folder='+destination);
    let launchArgs=args;
    if(study.thinLock){const invocation={entry:resolve(study.entry),entrySha256:sha(await readFile(study.entry)),args:args.slice(1)};
      const path=resolve(folder,'invocation-'+study.id+'.json');await writeFile(path,JSON.stringify(invocation,null,2)+'\n',{flag:'wx'});
      launchArgs=['.local/finish-local-lock-child-v2.mjs','--run=ROOT_GO_FINISH_LOCAL_LOCK_CHILD','--invocation='+path];}
    active={id:study.id,state:'starting',maxReserveUsd:study.maxReserveUsd,stopFile:study.stopFile??null,pid:null};
    const record={id:study.id,state:'starting',args:launchArgs,maxUnknownReserveUsd:study.maxReserveUsd,startedAt:new Date().toISOString()};
    records.push(record);await index();console.log(JSON.stringify({phase:'study_started',id:study.id,stage}));
    const result=await launch(launchArgs,resolve(folder,'logs',study.id+'.stdout.txt'),resolve(folder,'logs',study.id+'.stderr.txt'),
      async pid=>{active.pid=pid;active.state='active';record.pid=pid;await index();},
      phase=>{if(['closed','completed','settled','compact-group-closed','started'].includes(phase))console.log(JSON.stringify({phase:'child_boundary_progress',id:study.id,boundary:phase}));});
    let output=destination,artifacts={};
    try{
      if(study.discovery){const newNames=(await names(study.discovery.root)).filter(n=>!before.has(n)&&n.startsWith(study.discovery.prefix)&&
          (study.id!=='federation12'||/^\d+$/.test(n)));
        if(newNames.length!==1)throw Error('Expected exactly one new declared artifact directory');output=resolve(study.discovery.root,newNames[0]);}
      artifacts=await loadStudyArtifacts(study,output);
    }catch(e){record.artifactError={code:e.code??e.name};}
    const closure=validateStudyClosure(study.id,artifacts,result),accounting=conservativeStudyAccounting(artifacts,study,closure),
      claimReview=mechanismReview(study.id,artifacts);
    const sourceAfter=await current(),runnerBytesUnchanged=(await Promise.all(plan.files.map(async f=>
      sha(await readFile(f.path))===f.sha256))).every(Boolean);
    if(!same(sourceAfter,source)||!runnerBytesUnchanged){closure.permitsNext=false;closure.reasons.push('source_or_runner_changed_during_child');}
    Object.assign(record,{state:closure.permitsNext?'closed_valid':'stopped_for_analysis',finishedAt:new Date().toISOString(),
      process:result,folder:output,closure,accounting,claimReview,sourceAfter,runnerBytesUnchanged,artifacts:artifacts.files??[]});
    active=null;if(!closure.permitsNext)stoppedReason='child_failed_or_incomplete:'+study.id;
    if(closure.permitsNext&&claimReview?.stopAfterValidClosure)stoppedReason='unmetMechanismRequiresRootReview:'+study.id;
    if(interrupted||await exists(globalStop))stoppedReason??='operator_stop_after_settled_child';
    if(await exists(lock))stoppedReason??='child_left_NEWlock_active';
    await index();console.log(JSON.stringify({phase:'study_settled',id:study.id,exitCode:result.exitCode,
      permitsNext:closure.permitsNext,chargedBudgetUsd:accounting.chargedBudgetUsd,totalProviderCostUsd:accounting.totalProviderCostUsd}));
    if(stoppedReason)break;
  }
  await index();return {folder,stage,records:records.map(r=>({id:r.id,state:r.state})),stoppedReason,
    declaredStudies:14,notLaunched:plan.studies.filter(s=>!records.some(r=>r.id===s.id)).map(s=>s.id)};
  }finally{process.off('SIGINT',signal);process.off('SIGTERM',signal);}
}

if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url)){
  const o=Object.fromEntries(process.argv.slice(2).map(a=>{const i=a.indexOf('=');return i<0?[a.replace(/^--/,''),true]:[a.slice(2,i),a.slice(i+1)];}));
  const r=await runFinishStudies(o);console.log(JSON.stringify(r,null,2));if(r.stoppedReason)process.exitCode=1;
}
