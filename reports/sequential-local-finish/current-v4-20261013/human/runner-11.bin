/** Ignored, versioned preregistration/ancestry guards. No world or provider. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {resolve,sep} from 'node:path';
import {createHash} from 'node:crypto';
import {buildFingerprint,evaluatorFingerprint} from '../evaluation/harness.mjs';
import {humanCapacityEvaluatorFingerprint,HUMAN_CAPACITY_PROTOCOL} from '../evaluation/human-capacity-benchmark.mjs';
import {campaignPlan,validateHumanCampaignGate} from '../scripts/human-capacity-campaign.mjs';
import {requireLoadedSimulatorBuild} from '../evaluation/simulator-build.mjs';
import {classifyClosedGroup} from './compact-human-controls-coordinator.mjs';

export const OLD_SOURCE=Object.freeze({
  candidate:'9b4de8b7769c69a3279067a8a093ef6d2392ec8a9728e704f871a184a69934e3',
  baseEvaluator:'4b4d289e387b49da8d79fdccb260a67919b74339432731373204d96aee6668b3',
  humanEvaluator:'fb5b95f31ce62b7287c20cf0a9ff01480a37158ba0aae8a17b765bebf538944a',
  simulator:'561e6a02fbde1d047f999c4f077cbff83c438ba5c508c4d8d18bbf59ff78e94b'});
export const NEW_SOURCE=Object.freeze({...OLD_SOURCE,
  baseEvaluator:'d64f62747ecd5a36f77b9cd34dc6e1b2b37a77220cae9f206bb773a0a4263090',
  humanEvaluator:'75c635a59eda752820aabef317a42799915a46a5fc7fba82ad9d0382d69ea29e'});
export const V4_GATE_COUNTS=Object.freeze({platform:486,simulator:247,ui:113});
export const OLD_PATHS=Object.freeze({
  compactPlan:'.local/native-human-controls-prepared-1791865294895/plan.json',
  primary:'reports/human-capacity/native-primary-20261013',
  compact:'reports/human-capacity-controls/native-controls-20261013',
  additional:'.local/additional-human-controls-prepared-1791868369772/plan.json',
  readRelay:'.local/read-relay-error-amendment-1791867513712/plan.json'});
const fields=['candidate','baseEvaluator','humanEvaluator','simulator'];
const exactHash=x=>typeof x==='string'&&/^[a-f0-9]{64}$/.test(x);
const nonnegative=x=>typeof x==='number'&&Number.isFinite(x)&&x>=0;
export const sha=b=>createHash('sha256').update(b).digest('hex');
export const sameSource=(a,b)=>fields.every(k=>(k==='humanEvaluator'?(a?.humanEvaluator??a?.evaluator):a?.[k])===b?.[k]);
export const readJson=async path=>{const bytes=await readFile(resolve(path));return {path:resolve(path),bytes,
  sha256:sha(bytes),data:JSON.parse(bytes.toString('utf8'))};};
const inside=p=>resolve(p).toLowerCase().startsWith((resolve('.')+sep).toLowerCase());
const key=w=>[w.condition??w.profile,w.seed,w.arm].join(':');
export async function currentSource(){return {candidate:await buildFingerprint(),baseEvaluator:await evaluatorFingerprint(),
  humanEvaluator:await humanCapacityEvaluatorFingerprint(),simulator:await requireLoadedSimulatorBuild()};}

export function validateNewSource(source){
  if(!fields.every(k=>exactHash(source?.[k])&&source[k]===NEW_SOURCE[k]))
    throw Error('Bridge requires exact authorized v4 base/human hashes and unchanged real candidate/engine');
  return true;
}
export function validateV4Gate(freeze,source){
  validateNewSource(source);
  validateHumanCampaignGate(freeze,{candidate:source.candidate,baseEvaluator:source.baseEvaluator,simulator:source.simulator});
  if(HUMAN_CAPACITY_PROTOCOL.version!=='native-human-capacity-physical-response-v4')throw Error('Actual evaluator v4 required');
  if(JSON.stringify(gateCounts(freeze))!==JSON.stringify(V4_GATE_COUNTS))throw Error('Exact v4 full486/sim247/UI113 required');
  if(freeze.humanEvaluatorFingerprint!=null&&freeze.humanEvaluatorFingerprint!==source.humanEvaluator)
    throw Error('Freeze declares another human evaluator');
  return true;
}
export function gateCounts(freeze){return {
  platform:freeze.verification.cases.find(c=>c.name==='platform-tests')?.tests?.tests,
  simulator:freeze.verification.cases.find(c=>c.name==='simulator-tests')?.tests?.tests,
  ui:freeze.ui.cases.reduce((n,c)=>n+(c.report?.checks?.length??0),0)};}

function validateHistoricalRaw(w,{allowFailed=false}={}){
  if(w.candidateFingerprint!==OLD_SOURCE.candidate||w.baseEvaluatorFingerprint!==OLD_SOURCE.baseEvaluator||
      w.evaluatorFingerprint!==OLD_SOURCE.humanEvaluator||w.manifest?.engineBuild!==OLD_SOURCE.simulator||
      w.finalCandidateFingerprint!==OLD_SOURCE.candidate||w.finalEvaluatorFingerprint!==OLD_SOURCE.humanEvaluator||
      w.finalEngineBuild!==OLD_SOURCE.simulator||w.candidateChanged!==false||w.evaluatorChanged!==false||
      w.simulatorChanged!==false||!Array.isArray(w.invariants)||w.invariants.length||
      !Array.isArray(w.usage)&&w.usageMissing!==true)throw Error('Historical raw/source/ledger is not intact');
  if(w.status==='completed')return;
  if(!allowFailed||w.status!=='failed'||w.arm!=='C_decentralized'||!w.errors?.some(e=>e.code==='IDEMPOTENCY'))
    throw Error('Only the recorded failed decentralized world is an allowed historical failure');
}
export async function readHistoricalPrimary(folder=OLD_PATHS.primary){
  if(resolve(folder)!==resolve(OLD_PATHS.primary))throw Error('Exact predecessor primary path required');
  const protocol=await readJson(resolve(folder,'protocol.json')),summary=await readJson(resolve(folder,'summary.json'));
  if(protocol.data.family!=='primary'||protocol.data.worlds?.length!==12||!sameSource(protocol.data.source,OLD_SOURCE))
    throw Error('Exact v1 predecessor primary protocol required');
  const rows=[];for(const w of protocol.data.worlds){const r=await readJson(resolve(folder,`${w.condition}-${w.seed}-${w.arm}.json`));
    validateHistoricalRaw(r.data);rows.push(r);}
  const closure=classifyClosedGroup(protocol.data,summary.data,rows,{exitCode:0,signal:null});
  if(!closure.permitsNext)throw Error('Historical primary not closed intact');
  return {version:'v1',source:OLD_SOURCE,folder:resolve(folder),protocolSha256:protocol.sha256,summarySha256:summary.sha256,
    declaredRuns:12,observedRuns:12,raw:rows.map(r=>({path:r.path,sha256:r.sha256,status:r.data.status})),
    role:'Historical evaluated primary; not a current v4 gate or paired reference'};
}
export async function readHistoricalControls(folder=OLD_PATHS.compact){
  if(resolve(folder)!==resolve(OLD_PATHS.compact))throw Error('Exact predecessor compact path required');
  const index=await readJson(resolve(folder,'index.json')),plan=await readJson(OLD_PATHS.compactPlan);
  if(!sameSource(index.data.source,OLD_SOURCE)||index.data.stoppedReason!=='failed_or_incomplete_group'||
      index.data.records?.map(r=>r.id).join(',')!=='zero,fast_read,readers8,decentralized'||
      index.data.missingGroups?.join(',')!=='stress48,stress96'||index.data.unsettledReservedUsd!==0)
    throw Error('Exact settled partial v1 control predecessor required');
  const raw=[];for(const group of index.data.records){const declared=plan.data.groups.find(g=>g.id===group.id);
    if(group.worlds?.length!==declared.plan.worlds.length)throw Error('Historical worlds missing');
    const expected=new Set(declared.plan.worlds.map(key));
    for(const row of group.worlds){if(!inside(row.path))throw Error('Historical raw outside workspace');
      const r=await readJson(row.path);if(r.sha256!==row.sha256||!expected.delete(key(r.data)))throw Error('Historical raw bytes or cohort changed');
      validateHistoricalRaw(r.data,{allowFailed:group.id==='decentralized'});raw.push({...r,group:group.id});}
    if(expected.size)throw Error('Historical worlds incomplete');
    if(group.id==='decentralized'){
      if(group.closure?.permitsNext!==false||group.worlds.filter(w=>w.status==='failed').length!==1)
        throw Error('Recorded failed group must stay failed');
    }else if(group.closure?.permitsNext!==true)throw Error('Historical unaffected group was not closed valid');
  }
  if(raw.length!==11||raw.filter(r=>r.data.status==='failed').length!==1)throw Error('All eleven historical worlds, including failure, required');
  const valid8=raw.filter(r=>r.group!=='decentralized');
  return {version:'v1',source:OLD_SOURCE,folder:resolve(folder),indexSha256:index.sha256,planSha256:plan.sha256,
    declaredRuns:17,observedRuns:11,unlaunchedRuns:6,validClosedGroupRuns:valid8.length,
    failedGroupRuns:3,failedRuns:1,all17Closed:false,
    raw:raw.map(r=>({path:r.path,sha256:r.sha256,status:r.data.status,group:r.group})),
    accounting:{chargedBudgetUsd:nonnegative(index.data.chargedBudgetUsd)?index.data.chargedBudgetUsd:.60,
      totalProviderCostUsd:index.data.records.every(g=>nonnegative(g.budget?.costUsd))?
        index.data.records.reduce((s,g)=>s+g.budget.costUsd,0):null,
      countedExactlyOnce:true,includesFailedGroup:true,includesPrimary:false},
    role:'Partial historical controls; eight closed valid and failed group all retained, never relabeled seventeen closed'};
}

export async function bridgeGroups(){
  const old=await readJson(OLD_PATHS.compactPlan);return ['decentralized','stress48','stress96'].map(id=>{
    const original=old.data.groups.find(g=>g.id===id),plan=campaignPlan(original.options);
    if(JSON.stringify(plan.worlds)!==JSON.stringify(original.plan.worlds)||JSON.stringify(plan.config)!==JSON.stringify(original.plan.config)||
        plan.episodeBudgetUsd!==original.plan.episodeBudgetUsd||plan.totalBudgetUsd!==original.plan.totalBudgetUsd)
      throw Error('Original worlds/physics/durations/caps changed for '+id);
    return {...original,plan,version:'v2',reason:id==='decentralized'?'Whole affected same-seed group repeated':'Previously declared, never launched'};
  });
}
export function validateVersionedCoverage(oldControls,newIndex,current){
  validateNewSource(current);
  if(oldControls.version!=='v1'||!sameSource(oldControls.source,OLD_SOURCE)||oldControls.declaredRuns!==17||
      oldControls.observedRuns!==11||oldControls.validClosedGroupRuns!==8||oldControls.failedRuns!==1||oldControls.all17Closed!==false)
    throw Error('Historical failure/denominators must remain visible');
  if(!sameSource(newIndex.source,current)||newIndex.stoppedReason||newIndex.records?.map(r=>r.id).join(',')!=='decentralized,stress48,stress96'||
      newIndex.records.some(g=>g.closure?.permitsNext!==true||g.worlds?.length!==3)||
      newIndex.records.flatMap(g=>g.worlds).length!==9)
    throw Error('Nine current-version paired worlds must close intact');
  return {type:'EXPLICIT_VERSIONED_COVERAGE',v1:oldControls,v2:{source:current,declaredRuns:9,observedRuns:9},
    coverageUnits:17,statisticalPoolingAllowed:false,all17SingleVersionClosed:false,
    note:'Coverage combines requirement inventory only: eight v1 closed controls plus nine v2 paired controls. All old eleven observed worlds remain visible. No mixed-version gain/RMST/CI.'};
}
export function verifyCurrentHumanRaws(rows,source){
  validateNewSource(source);
  for(const r of rows){const w=r.data??r;
    if(w.status!=='completed'||w.candidateFingerprint!==source.candidate||w.baseEvaluatorFingerprint!==source.baseEvaluator||
      w.evaluatorFingerprint!==source.humanEvaluator||w.manifest?.engineBuild!==source.simulator||
      w.finalCandidateFingerprint!==source.candidate||w.finalEvaluatorFingerprint!==source.humanEvaluator||
      w.finalEngineBuild!==source.simulator||w.candidateChanged!==false||w.evaluatorChanged!==false||w.simulatorChanged!==false||
      !Array.isArray(w.invariants)||w.invariants.length||!Array.isArray(w.usage)&&w.usageMissing!==true)
      throw Error('Current-version raw/source/ledger incomplete or changed');
  }
  return true;
}
export async function readClosedBridge(folder,source,preparedPlan){
  const index=await readJson(resolve(folder,'index.json')),protocol=await readJson(resolve(folder,'protocol.json')),
    historical=await readHistoricalControls(),primary=await readHistoricalPrimary();
  if(!sameSource(index.data.source,source)||!sameSource(protocol.data.source,source)||
      protocol.data.plan?.sha256!==preparedPlan.sha256||JSON.stringify(protocol.data.historicalControls)!==JSON.stringify(historical)||
      JSON.stringify(protocol.data.primary)!==JSON.stringify(primary))throw Error('Closed bridge/predecessor/plan scope mismatch');
  const coverage=validateVersionedCoverage(historical,index.data,source),rows=[];
  for(const group of index.data.records){const declared=preparedPlan.data.groups.find(g=>g.id===group.id),expected=new Set(declared.plan.worlds.map(key)),groupRows=[];
    for(const r of group.worlds){if(!inside(r.path))throw Error('Bridge raw outside workspace');const raw=await readJson(r.path);
      if(raw.sha256!==r.sha256||!expected.delete(key(raw.data)))throw Error('Bridge raw bytes/cohort mismatch');rows.push(raw);groupRows.push(raw);}
    if(expected.size)throw Error('Bridge raw worlds missing');
    if(!inside(group.summary?.path??''))throw Error('Bridge summary outside workspace');
    const summary=await readJson(group.summary.path);
    if(summary.sha256!==group.summary.sha256||!classifyClosedGroup(declared.plan,summary.data,groupRows,group.closure.process).permitsNext)
      throw Error('Bridge comparison closure cannot be credited from a shallow index flag');
  }
  if(rows.length!==9)throw Error('All nine bridge outcomes required');verifyCurrentHumanRaws(rows,source);
  return {type:'EXPLICIT_VERSIONED_COVERAGE',folder:resolve(folder),indexSha256:index.sha256,protocolSha256:protocol.sha256,
    coverage,raw:rows.map(r=>({path:r.path,sha256:r.sha256})),statisticalPoolingAllowed:false,all17SingleVersionClosed:false,
    accounting:{oldControlChargedUsd:historical.accounting.chargedBudgetUsd,
      newControlChargedUsd:nonnegative(index.data.chargedBudgetUsd)?index.data.chargedBudgetUsd:.45,
      oldControlCountedExactlyOnce:true,newControlCountedExactlyOnce:true,includesPrimary:false}};
}

/** Only version/source metadata change. Every native/API parameter is retained. */
export function rebindPlan(old,{source,oldPath,oldSha,freezePath,freezeSha,declaredAt}){
  validateNewSource(source);const plan=structuredClone(old);
  plan.sourceAtDeclaration=source;plan.declaredAt=declaredAt;
  if(plan.version)plan.version=HUMAN_CAPACITY_PROTOCOL.version;
  plan.freeze={path:resolve(freezePath),sha256:freezeSha};
  const inputs=[...(plan.execution?.episodeInputs??[]),...(plan.groups??[]).flatMap(g=>g.execution?.episodeInputs??[])];
  for(const input of inputs){input.candidateFingerprint=source.candidate;input.evaluatorBuild=source.humanEvaluator;}
  plan.versionAmendment={schema:'opaque-episode-version-bridge-v2',original:{path:resolve(oldPath),sha256:oldSha},
    predecessorSource:OLD_SOURCE,source,reason:'Bounded opaque evaluator episode namespace; unchanged native/UI/physics/input/configuration',
    allowedChanges:['sourceAtDeclaration','declaredAt','version','freeze','API input candidateFingerprint/evaluatorBuild','versionAmendment'],
    statisticalPoolingAllowed:false,originalProtocolRetained:true};
  return plan;
}
export function validateReboundPlan(plan,old,{source,oldPath,oldSha}){
  validateNewSource(source);
  if(!plan.versionAmendment||plan.versionAmendment.original.path!==resolve(oldPath)||plan.versionAmendment.original.sha256!==oldSha||
      !sameSource(plan.versionAmendment.predecessorSource,OLD_SOURCE)||!sameSource(plan.sourceAtDeclaration,source))
    throw Error('Exact version amendment/source required');
  const expected=rebindPlan(old,{source,oldPath,oldSha,freezePath:plan.freeze.path,freezeSha:plan.freeze.sha256,declaredAt:plan.declaredAt});
  if(JSON.stringify(plan)!==JSON.stringify(expected))throw Error('Amendment changed an unapproved parameter or historical block');
  return true;
}
export async function validateReboundFile(plan,{sha256,expectedSha,current,kind}){
  if(!exactHash(expectedSha)||sha256!==expectedSha)throw Error('Exact new archived plan SHA required');
  const expectedPath=OLD_PATHS[kind],originalSha={additional:'a4435d5c32a27058f8cdad57ca1cd162786bfd59bc69858b0e9af655221af2d4',
    readRelay:'bb542915bb5cdf280a8b5bed5e43568016ecc45f41cbeaddae0272673aee6058'}[kind];
  if(!expectedPath||plan.versionAmendment?.original?.path!==resolve(expectedPath)||
      plan.versionAmendment.original.sha256!==originalSha)throw Error('Exact immutable predecessor plan required');
  const original=await readJson(plan.versionAmendment?.original?.path??'');
  return validateReboundPlan(plan,original.data,{source:current,oldPath:original.path,oldSha:original.sha256});
}

export async function prepareBridge(options={}){
  if(options.template){
    const old=await readJson(OLD_PATHS.compactPlan),folder=resolve(options.folder??'.local/version-bridge-v2-template-'+Date.now());
    const actual=HUMAN_CAPACITY_PROTOCOL.version==='native-human-capacity-physical-response-v4'?await currentSource():null;
    if(actual)validateNewSource(actual);
    const template={schema:'native-control-version-bridge-v2-template',state:'PENDING_FRESH_FULL_UI_T27_FREEZE',declaredAt:new Date().toISOString(),
      worldsStarted:0,modelCalls:0,authorization:'ROOTGO_PREP_BRIDGE_V2',predecessorSource:OLD_SOURCE,newSource:actual,
      groups:old.data.groups.filter(g=>['decentralized','stress48','stress96'].includes(g.id)),
      declaredNewWorlds:9,paidEpisodes:3,maximumReservedUsd:.45,maximumModelCalls:72,
      predecessorPrimary:OLD_PATHS.primary,predecessorControls:OLD_PATHS.compact,
      oldControlDenominator:{declared:17,observed:11,closedValidGroupWorlds:8,failedGroupWorlds:3,notLaunched:6},
      statisticalPoolingAllowed:false,all17SingleVersionClosed:false,required:['New v4 exact base/human hashes','Same candidate/engine',
        'Fresh full/UI gate','Fresh T27 receipt','Original plans/raw/usage SHA retained','Root launch GO','NEWlock empty'],
      followups:{additional:OLD_PATHS.additional,readRelay:OLD_PATHS.readRelay,state:'Archive new source-bound plans with identical API input parameters'}};
    await mkdir(folder,{recursive:true});await writeFile(resolve(folder,'template.json'),JSON.stringify(template,null,2)+'\n',{flag:'wx'});
    return {folder,state:template.state,templateSha256:sha(JSON.stringify(template,null,2)+'\n'),worldsStarted:0,modelCalls:0};
  }
  for(const p of ['freeze','t27'])if(!options[p])throw Error('Explicit fresh --'+p+' required for v2 seal');
  const source=await currentSource(),freeze=await readJson(options.freeze),t27=await readJson(options.t27);
  validateV4Gate(freeze.data,source);
  if(t27.data?.valid!==true||t27.data.passed!==true||t27.data.sourceUnchanged!==true||
      [t27.data.initialFingerprints,t27.data.finalFingerprints].some(f=>f?.candidate!==source.candidate||
        f?.evaluator!==source.baseEvaluator||f?.simulator!==source.simulator))throw Error('Fresh v4 T27 proof required');
  const primary=await readHistoricalPrimary(),historicalControls=await readHistoricalControls(),groups=await bridgeGroups(),
    folder=resolve(options.folder??'.local/version-bridge-v2-prepared-'+Date.now()),at=new Date().toISOString();
  await mkdir(resolve(folder,'bytes'),{recursive:true});
  const amended={};for(const [name,path]of [['additional',OLD_PATHS.additional],['readRelay',OLD_PATHS.readRelay]]){
    const original=await readJson(path),plan=rebindPlan(original.data,{source,oldPath:path,oldSha:original.sha256,
      freezePath:freeze.path,freezeSha:freeze.sha256,declaredAt:at}),bytes=JSON.stringify(plan,null,2)+'\n',destination=resolve(folder,name+'-plan.json');
    validateReboundPlan(plan,original.data,{source,oldPath:path,oldSha:original.sha256});
    await writeFile(destination,bytes,{flag:'wx'});amended[name]={path:destination,sha256:sha(bytes),original:{path:original.path,sha256:original.sha256}};
  }
  const files=[];for(const path of ['.local/version-bridge-v2.mjs','.local/compact-human-controls-bridge-v2.mjs',
      '.local/run-additional-human-controls-v2.mjs','.local/run-read-relay-error-amendment-v2.mjs',
      '.local/version-bridge-v2.test.mjs','scripts/human-capacity-campaign.mjs','evaluation/human-capacity-benchmark.mjs']){
    const bytes=await readFile(path);files.push({path:resolve(path),sha256:sha(bytes)});
    await writeFile(resolve(folder,'bytes',String(files.length-1).padStart(2,'0')+'.bin'),bytes,{flag:'wx'});
  }
  const plan={schema:'native-human-compact-control-bridge-before-v2-outcomes',state:'PREPARED_NOT_LAUNCHED',declaredAt:at,
    source,predecessorSource:OLD_SOURCE,version:HUMAN_CAPACITY_PROTOCOL.version,groups,primary,historicalControls,amended,files,
    freeze:{path:freeze.path,sha256:freeze.sha256,counts:gateCounts(freeze.data)},t27:{path:t27.path,sha256:t27.sha256},
    declaredRuns:9,paidEpisodes:3,maximumReservedUsd:.45,episodeCapUsd:.15,maximumModelCalls:72,
    universalLock:resolve('.local/PAID_RESEARCH_STUDY.lock'),stopFile:resolve('.local/STOP_COMPACT_BRIDGE_V2'),
    coverageType:'EXPLICIT_VERSIONED_COVERAGE',statisticalPoolingAllowed:false,all17SingleVersionClosed:false,
    worldsStarted:0,modelCalls:0};
  const bytes=JSON.stringify(plan,null,2)+'\n';await writeFile(resolve(folder,'plan.json'),bytes,{flag:'wx'});
  await writeFile(resolve(folder,'freeze.json'),freeze.bytes,{flag:'wx'});await writeFile(resolve(folder,'t27.json'),t27.bytes,{flag:'wx'});
  return {folder,planPath:resolve(folder,'plan.json'),planSha256:sha(bytes),amended,source,worldsStarted:0,modelCalls:0};
}
