{
  "name": "aidscaler-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "lab": "node --env-file-if-exists=.env.local scripts/lab.mjs",
    "lab:resume": "node --env-file-if-exists=.env.local scripts/resume-lab.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "demo:repair": "node --env-file-if-exists=.env.local scripts/blocked-repair.mjs",
    "demo": "node --env-file-if-exists=.env.local scripts/service-demo.mjs",
    "demo:live": "node --env-file-if-exists=.env.local scripts/live-response.mjs",
    "partner": "node --env-file-if-exists=.env.local scripts/partner.mjs",
    "evaluate": "node --env-file-if-exists=.env.local scripts/evaluate.mjs",
    "test:live": "node --env-file-if-exists=.env.local scripts/live.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:offline": "node --test tests/browser/offline-migration.test.mjs",
    "test:journeys": "node scripts/journey-test.mjs",
    "test:responses": "node scripts/response-journey.mjs",
    "test:review": "node scripts/review-journey.mjs",
    "test:semantic": "node --env-file-if-exists=.env.local scripts/semantic-load.mjs",
    "test:load": "node --max-old-space-size=8192 scripts/load.mjs",
    "test:sources": "node scripts/source-smoke.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "setup:media": "node scripts/setup-media.mjs",
    "test:media": "node --env-file-if-exists=.env.local scripts/media-smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@google-cloud/pubsub": "^6.3.0",
    "@google-cloud/tasks": "^7.3.0",
    "google-auth-library": "^11.3.1",
    "lucide-static": "^0.574.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.6.2"
  }
}
