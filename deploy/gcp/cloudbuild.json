{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-f",
        "Dockerfile",
        "-t",
        "${_REPOSITORY}/platform:${_TAG}",
        "."
      ]
    }
  ],
  "images": [
    "${_REPOSITORY}/platform:${_TAG}"
  ],
  "timeout": "1800s",
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
