PORT=4400
DATA_DIR=.local/pgdata
EVIDENCE_DIR=.local/evidence
# Optional server Postgres instead of the embedded PostgreSQL used locally:
# DATABASE_URL=postgresql://aidscaler:aidscaler@127.0.0.1:5432/aidscaler
MODEL_PROVIDER=openrouter
AUTO_INVESTIGATE=true
AUTO_DISCOVER=true
AUTO_BATCH_WAIT_MS=15000
AUTO_BATCH_MIN_SIGNALS=8
MODEL_HOURLY_CALL_LIMIT=600
MODEL_HOURLY_BUDGET_USD=2
MODEL_ID=google/gemma-4-31b-it
OPENROUTER_API_KEY=
MODEL_EPISODE_BUDGET_USD=2
MODEL_TIMEOUT_MS=120000
MODEL_MAX_CALLS=8
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_REASONING=true
MODEL_PROVIDER_SORT=latency
MODEL_PRICE_MULTIPLIER=2
INVESTIGATION_TIMEOUT_MS=360000
SOURCE_URL=http://127.0.0.1:4319
# pnpm lab provisions its own source on :4329 and defaults to the Takamatsu map.
# AIDSCALER_TOPOLOGY=takamatsu
# Provision per-organization keys using scripts/lab.mjs, never the observer key.
# SOURCE_AGENT_KEY=
# SOURCE_HUMAN_KEY=
# AIDSCALER_BOOTSTRAP_PASSWORD=
